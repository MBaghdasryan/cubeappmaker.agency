{
  "name": "cubeappmaker-hybrid-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.json --local --ip 127.0.0.1 --port 8788 --inspector-port 0",
    "check:deploy": "wrangler deploy --config wrangler.json --dry-run",
    "deploy": "wrangler deploy --config wrangler.json",
    "build": "esbuild src/hybrid/worker/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/index.js --minify"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.147.0"
  }
}
