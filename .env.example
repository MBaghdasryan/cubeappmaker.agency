# Runtime only; never put server secrets in NEXT_PUBLIC_* variables.
APP_ORIGIN=https://www.cubeappmaker.agency
DATA_DIR=/app/data
# Optional HTTP adapter: POST {problem,allowedComponents} -> {summary,components}
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
# Optional direct OpenAI-compatible chat-completions provider (any compatible vendor).
AI_CHAT_URL=
AI_CHAT_KEY=
AI_MODEL=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# Default safe global limits; only trust proxy headers when origin port is private.
TRUST_PROXY=false
RECOMMEND_LIMIT_PER_MINUTE=12
LEAD_LIMIT_PER_MINUTE=5
AI_DAILY_LIMIT=200
